{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:full": "concurrently -n server,queue,logs,vite -c blue,yellow,gray,magenta \"php artisan serve\" \"php artisan queue:work --sleep=3 --tries=3\" \"php artisan pail --timeout=0\" \"vite\"",
        "dev:server": "php artisan serve",
        "dev:queue": "php artisan queue:work --sleep=3 --tries=3",
        "dev:logs": "php artisan pail --timeout=0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "playwright": "^1.61.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "hls.js": "^1.6.16"
    }
}
